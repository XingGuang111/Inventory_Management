# ============ 前端（Node/Vite） ============
# npm/yarn/pnpm 依赖，体积大，通过 package-lock.json 精确重建
node_modules/
# Vite 构建产物，通过 `npm run build` 重新生成
frontend/dist/
# 前端调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
# Vite 缓存
.vite/
frontend/.vite/

# ============ PHP 后端 ============
# 若将来引入 Composer，vendor 目录也不入库
vendor/
composer.phar

# ============ 敏感信息 / 本地配置 ============
# 数据库凭据、密钥等（本项目当前无，预留）
.env
.env.local
.env.*.local
# 若将来把 db.php 的凭据抽出到独立文件，也应忽略
api/config.local.php

# ============ 运行时数据 / 日志 ============
*.log
logs/
tmp/
cache/

# ============ 数据库导出 / 备份 ============
*.sql.gz
*.sql.bak
backup/
# 注意：sql/stock.sql 是建表脚本，需要入库，不受此规则影响

# ============ 编辑器 / IDE ============
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.project
.settings/

# ============ 操作系统临时文件 ============
.DS_Store
Thumbs.db
desktop.ini

# ============ Claude Code 本地设置 ============
.claude/

# ============ 打包 / 归档 ============
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ============ 其他 ============
.history/
